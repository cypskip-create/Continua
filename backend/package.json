{
  "name": "continua-data",
  "version": "0.1.0",
  "description": "Continua Data — core market data infrastructure layer (NSE-first, multi-exchange ready)",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "worker:price": "tsx src/workers/priceWorker.ts",
    "worker:financials": "tsx src/workers/financialsWorker.ts",
    "worker:corporate-actions": "tsx src/workers/corporateActionsWorker.ts",
    "worker:announcements": "tsx scripts/runAnnouncementsBridgeOnce.ts",
    "worker:candles": "tsx src/workers/candlesWorker.ts",
    "worker:financial-candidates": "tsx scripts/runFinancialCandidatesBridgeOnce.ts",
    "financials:review": "tsx scripts/listFinancialStatementCandidates.ts",
    "financials:draft": "tsx scripts/draftFinancialStatementCandidate.ts",
    "financials:confirm": "tsx scripts/confirmFinancialStatementCandidate.ts",
    "financials:reject": "tsx scripts/rejectFinancialStatementCandidate.ts",
    "apikey:create": "tsx scripts/generateApiKey.ts",
    "apikey:revoke": "tsx scripts/revokeApiKey.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "lru-cache": "^10.4.3",
    "node-cron": "^4.6.0",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.12",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^5.0.0"
  }
}
{
  "name": "continua-data",
  "version": "0.1.0",
  "description": "Continua Data — core market data infrastructure layer (NSE-first, multi-exchange ready)",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "worker:price": "node src/workers/priceWorker.js",
    "worker:financials": "node src/workers/financialsWorker.js",
    "worker:corporate-actions": "node src/workers/corporateActionsWorker.js",
    "worker:announcements": "node scripts/runAnnouncementsBridgeOnce.js",
    "worker:candles": "node src/workers/candlesWorker.js",
    "worker:financial-candidates": "node scripts/runFinancialCandidatesBridgeOnce.js",
    "worker:news": "node scripts/runNewsBridgeOnce.js",
    "research:import": "node scripts/importMarketResearch.js",
    "history:import": "node scripts/importHistoricalPrices.js",
    "history:coverage": "node scripts/historyCoverage.js",
    "history:migrate": "node scripts/applyHistoryMigration.js",
    "news:revalidate": "node scripts/revalidateNews.js",
    "source:remove": "node scripts/removeNewsSource.js",
    "financials:review": "node scripts/listFinancialStatementCandidates.js",
    "financials:draft": "node scripts/draftFinancialStatementCandidate.js",
    "financials:confirm": "node scripts/confirmFinancialStatementCandidate.js",
    "financials:reject": "node scripts/rejectFinancialStatementCandidate.js",
    "apikey:create": "node scripts/generateApiKey.js",
    "apikey:revoke": "node scripts/revokeApiKey.js"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "lru-cache": "^10.4.3",
    "node-cron": "^4.6.0",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.12",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}

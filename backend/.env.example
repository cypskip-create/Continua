# Server
NODE_ENV=development
PORT=4000
# WebSockets share PORT with the REST server (WS_PORT is legacy/unused).
WS_PORT=4001
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Cache
CACHE_DRIVER=memory
REDIS_URL=redis://localhost:6379

NSE_CLIENT_MODE=mock

# Explicit local fixtures. Production uses live mode and NSE_CLIENT_MODE=mystocks.
ADAPTER_MODE=mock
# afx.kwayisi.org scrape client — the polite request spacing and page-cache
# TTL for AfxClient. Only relevant when NSE_CLIENT_MODE=afx.
AFX_MIN_REQUEST_INTERVAL_MS=1000
AFX_POLL_INTERVAL_MS=300000
# Comma-separated ticker override for AfxClient, e.g. SCOM,EQTY,KCB.
# Leave unset to use the built-in KNOWN_NSE_SYMBOLS list.
AFX_TICKERS=

# Ingestion
PRICE_POLL_INTERVAL_MS=4000000
FINANCIALS_SYNC_CRON=0 2 * * *
CORPORATE_ACTIONS_SYNC_CRON=0 3 * * *
# Scraper bridges — all default to every 15 minutes in code (env.ts) if unset.
ANNOUNCEMENTS_BRIDGE_CRON=*/5 * * * *
FINANCIAL_CANDIDATES_BRIDGE_CRON=*/5 * * * *
NEWS_BRIDGE_CRON=*/2 * * * *
NEWS_SCRAPER_URL=https://continua-scraper.onrender.com
# Admin financials review page (see docs/admin/financials-review.md). Unset = admin routes refuse all requests.
ADMIN_API_KEY=

# API auth
API_KEY_AUTH_ENABLED=true
DEV_API_KEY=dev-local-only-key
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_DEFAULT=120

# Trading calendar
IGNORE_TRADING_CALENDAR=false

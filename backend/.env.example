# Server
NODE_ENV=development
PORT=4000
WS_PORT=4001
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Cache
CACHE_DRIVER=memory
REDIS_URL=redis://localhost:6379

# Mansa market-data feed
NSE_CLIENT_MODE=mock
MANSA_API_BASE_URL=
MANSA_API_KEY=
# Optional DNS edge override when local DNS routes the host incorrectly.
MANSA_API_IP=

# Top-level adapter switch. "mock" (default) = seeded synthetic NSE data
# everywhere. "live" = every ACTIVE_EXCHANGES symbol goes through Mansa,
# EXCEPT NSE, which is routed by NSE_ADAPTER_SOURCE below.
ADAPTER_MODE=mock
# Only takes effect when ADAPTER_MODE=live. "mansa" (default) = NSE also
# goes through Mansa's movers feed (currently unreliable — see
# backend/src/adapters/nse/nseClient.ts RealNseClient.fetchQuotes comment).
# "nse_client" = NSE is routed to NseAdapter, which then uses
# NSE_CLIENT_MODE below to pick its own transport (mock/live/afx).
NSE_ADAPTER_SOURCE=mansa
# afx.kwayisi.org scrape client — the polite request spacing and page-cache
# TTL for AfxClient. Only relevant when NSE_CLIENT_MODE=afx.
AFX_MIN_REQUEST_INTERVAL_MS=1000
AFX_POLL_INTERVAL_MS=300000
# Comma-separated ticker override for AfxClient, e.g. SCOM,EQTY,KCB.
# Leave unset to use the built-in KNOWN_NSE_SYMBOLS list.
AFX_TICKERS=

# Ingestion
PRICE_POLL_INTERVAL_MS=4000000
FINANCIALS_SYNC_CRON=0 2 * * *
CORPORATE_ACTIONS_SYNC_CRON=0 3 * * *

# API auth
API_KEY_AUTH_ENABLED=true
DEV_API_KEY=dev-local-only-key
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_DEFAULT=120

# Trading calendar
IGNORE_TRADING_CALENDAR=false
NODE_ENV=development
PORT=4100
LOG_LEVEL=info

# Same Postgres instance as continua-data / the app.
DATABASE_URL=postgresql://postgres:password@localhost:5432/continua

RAW_STORAGE_DRIVER=local
RAW_STORAGE_LOCAL_PATH=./data/raw

DEFAULT_REQUESTS_PER_SECOND=1
DEFAULT_REQUEST_TIMEOUT_MS=30000
DEFAULT_MAX_RETRIES=3

MAX_RESPONSE_SIZE_BYTES=52428800
MAX_CRAWL_DEPTH=6

CRAWLER_USER_AGENT=ContinuaBot/0.1 (+https://continua.example/bot)
RESPECT_ROBOTS_TXT=true

# Phase 6 — scheduling. Per-source overrides live in
# scraping.sources.config.schedule (a cron string); this is only the
# fallback for sources that don't specify their own.
DEFAULT_CRAWL_CRON=0 */6 * * *
# RSS news uses this cadence, independent of slow filing schedules.
NEWS_CRAWL_CRON=*/10 * * * *
SCHEDULER_ENABLED=true

{
  "name": "continua-scraper",
  "version": "0.1.0",
  "description": "Continua Web Intelligence / Data Ingestion Engine — discovers, crawls, and extracts raw financial material for the Continua data layer. Deployed as its own service, separate from continua-data (backend/), so heavy crawl/OCR work never competes with the live price/WebSocket process for memory or CPU.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "node-cron": "^4.6.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "rss-parser": "^3.13.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8",
    "playwright": "^1.63.0"
    
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "pdf-parse": {
      "pdfjs-dist": "6.2.108"
    }
  }
}
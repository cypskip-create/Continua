{
  "name": "continua-scraper",
  "version": "0.1.0",
  "description": "Continua Web Intelligence / Data Ingestion Engine — discovers, crawls, and extracts raw financial material for the Continua data layer. Deployed as its own service, separate from continua-data (backend/), so heavy crawl/OCR work never competes with the live price/WebSocket process for memory or CPU.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "history:backfill": "node scripts/backfillHistory.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "node-cron": "^4.6.0",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "playwright": "^1.63.0",
    "rss-parser": "^3.13.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.6",
    "typescript": "^5.5.4",
    "vitest": "4.1.12"
  }
}

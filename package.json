{
  "name": "continua-workspace",
  "private": true,
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "npm --workspace app run dev",
    "build": "npm run security:check && npm --workspace app run build && node infra/security/browser-secret-audit.mjs app/dist",
    "build:dev": "npm --workspace app run build:dev",
    "lint": "npm --workspace app run lint",
    "preview": "npm --workspace app run preview",
    "security:check": "node --test infra/cloudflare/*.test.mjs && node node_modules/typescript/bin/tsc --noEmit -p app/tsconfig.app.json"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "buffer": "^6.0.3",
    "express": "^5.2.1",
    "html-to-image": "^1.11.13",
    "nanoid": "^3.3.18",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}

{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "continua",
  "account_id": "de867ecc0ef417877b8d4ef9580c4fe7",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "triggers": { "crons": ["0 * * * *"] },
  "assets": {
    "directory": "../../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": { "BACKEND_ORIGIN": "https://continua-backend.onrender.com", "PUBLIC_EDGE_CACHE": "true", "MEDIA_STORAGE_ENABLED": "true", "APPLICATION_SCHEDULE_ENABLED": "true", "AUTH_PROVIDER": "neon-managed", "NEON_AUTH_PRODUCTION_ENABLED": "true", "NEON_AUTH_STAGING_ENABLED": "false", "NEON_AUTH_BRANCH_ID": "br-noisy-block-b4z5yxup", "MIGRATION_WRITE_FREEZE": "false" },
  "r2_buckets": [{"binding":"MEDIA_BUCKET","bucket_name":"continua-public-media"}],
  "ratelimits": [
    {"name":"AUTH_RATE_LIMIT","namespace_id":"42004","simple":{"limit":20,"period":60}},
    {"name":"EDGE_RATE_LIMIT","namespace_id":"42001","simple":{"limit":120,"period":60}},
    {"name":"PAYMENT_RATE_LIMIT","namespace_id":"42002","simple":{"limit":10,"period":60}},
    {"name":"MEDIA_RATE_LIMIT","namespace_id":"42003","simple":{"limit":10,"period":60}}
  ],
  "observability": { "enabled": true, "redact_query_string": true }
}

# Public frontend build configuration (never place server secrets here)
VITE_CONTINUA_API_URL=/api/v1
VITE_AUTH_PROVIDER=better-auth
VITE_CONTINUA_WEBSITE_ORIGIN=https://continua.cypriankiprop41.workers.dev
# BACKEND_API_KEY is a Worker runtime SECRET, not a VITE/build variable.
# Private subscriptions use same-origin /api/v1/events with a short-lived user
# token in their first frame. Market reads refresh through the owned gateway.

# Public frontend build configuration (never place server secrets here)
VITE_CONTINUA_API_URL=/api/v1
VITE_CONTINUA_WS_URL=wss://continua-backend.onrender.com
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_ANON_KEY
# Optional after the parallel hostname is verified:
# VITE_CONTINUA_WEBSITE_ORIGIN=https://continua-preview.YOUR_SUBDOMAIN.workers.dev
# BACKEND_API_KEY is a Worker runtime SECRET, not a VITE/build variable.
# Legacy direct Render WebSockets currently require a first-party public API key.
# Do not put the Worker secret in VITE variables to make WebSockets work.
# Validate a short-lived realtime-token path before enabling this preview broadly.
